{
  "name": "now-planner",
  "version": "2.1.1",
  "private": true,
  "type": "module",
  "description": "此刻：米白茶绿风格的云端个人智能任务规划器",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check src/main.js && node --check src/sync.js && node --check src/native.js && node --check scripts/android-build.mjs && node --check extension/content.js",
    "package:extension": "node scripts/package-extension.mjs",
    "android:sync": "vite build && cap sync android",
    "android:open": "cap open android",
    "android:debug": "node scripts/android-build.mjs debug",
    "android:release": "node scripts/android-build.mjs release"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capawesome/capacitor-badge": "^8.0.3",
    "@supabase/supabase-js": "^2.57.0",
    "idb": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "jszip": "^3.10.2",
    "supabase": "^2.119.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.7"
  }
}
